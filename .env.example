# 재고 저장소 — 구글 스프레드시트(Apps Script 웹 앱) 주소
# 비워 두면 재고가 이 기기 브라우저에만 저장됩니다(개발용).
# 배포본에서는 GitHub 저장소의 Secrets 에 같은 이름으로 넣습니다.
VITE_STOCK_API="https://script.google.com/macros/s/AKfycb.../exec"

# Apps Script 스크립트 속성의 API_KEY 와 같은 값
# 브라우저에서 볼 수 있는 값이므로 장난 방지 수준의 잠금입니다.
VITE_STOCK_KEY="여기에_임의의_문자열"

# 아래는 AI Studio에서 쓰던 값입니다. 도안 앱 자체는 사용하지 않습니다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
